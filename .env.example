# noxaDBRS's settings. Copy to .env, or set them in the systemd unit.
# DISCORD_TOKEN: the bot's token (Discord Developer Portal › Bot). Never commit it.
DISCORD_TOKEN=
# GUILD_ID: the one server noxaDBRS serves (Dragon Ball: Rising Spirit, where Noxa ran).
GUILD_ID=1556437391693324349
# NOXADBRS_DB: the database file; on the Pi, keep it on the NVMe.
NOXADBRS_DB=/opt/noxadbrs/noxadbrs.db
# RUST_LOG: how much noxaDBRS logs. info: every command, change and failure; info,noxadbrs=debug adds reply texts.
RUST_LOG=info
# WEB_URL: where staff open the admin pages; the links /z_moderator_admin sends start with it.
WEB_URL=https://dbrs.neokai.org
# RELAY_URL, RELAY_SECRET: the neoKai relay (neoKai/relay-dbrs). The secret matches the Worker's RELAY_SECRET.
RELAY_URL=wss://dbrs.neokai.org/relay
RELAY_SECRET=
# PICTURES_CHANNEL: where uploaded character pictures are kept, as messages. Unset: uploads are off.
PICTURES_CHANNEL=1572414365821313165
# WEB_BIND: also serve the pages as plain HTTP on this machine (e.g. 127.0.0.1:8787). Off with a relay unless set.
